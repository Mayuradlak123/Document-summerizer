# General Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# Groq model IDs (optional; sensible defaults are set in app/config/settings.py).
# Groq retires models regularly -- if you see a 404 "model does not exist", list
# what your key can access with:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_HEAVY=openai/gpt-oss-120b
GROQ_MODEL_JSON=openai/gpt-oss-120b
# Multimodal model for scanned-PDF OCR. Leave blank to skip Vision OCR entirely.
GROQ_MODEL_VISION=

# LangSmith Observability Configuration
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=document-summarizer-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Chroma Vector Database Configuration
CHROMA_API_KEY=
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Redis Cache Configuration (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Neo4j Graph Database Configuration (Optional)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# PostgreSQL Database Configuration (Optional)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_URL=